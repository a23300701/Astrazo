---
import Navigation from '../components/Navigation.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const pageTitle = "About Me";
const identity = {
  firstName: "Dante",
  country: "México",
  city: "Guadalajara, Jalisco",
  occupation: "Estudiante",
  hobbies: ["boliche"],
};
const skills = ["HTML", "CSS", "JavaScript", "Astro"];
const skillColor = "navy";
const fontWeight = "bold";
const textCase = "uppercase";
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
		<style define:vars={{ skillColor, fontWeight, textCase }}>
			h1 {
				color: purple;
				font-size: 4rem;
			}
			.skill {
				color: var(--skillColor);
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}
		</style>
	</head>

	<body>
		<Header />
		<h1>{pageTitle}</h1>
		<p>Cosas interesantes:</p>
		<ul>
			<li>Me llamo {identity.firstName}.</li>
			<li>Vivo en {identity.city}, {identity.country}.</li>
			<li>Ahorita soy {identity.occupation}.</li>
			{identity.hobbies.length >= 1 &&
				<li>Mi hobby es el: {identity.hobbies[0]}</li>
			}
		</ul>

		<p>Mis disque habilidades:</p>
		<ul>
			{skills.map((skill) => <li class="skill">{skill}</li>)}
		</ul>

		<p>Este es el about está curioso esto del Astro</p>
		<Footer />
        <script>
	        import "../scripts/menu.js";
        </script>
	</body>
</html>