---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
const pageTitle = "Acerca de mi";
const identity = {
  firstName: "Dante",
  country: "México",
  city: "Guadalajara, Jalisco",
  occupation: "Estudiante",
  hobbies: ["boliche"],
};
const skills = ["HTML", "CSS", "JavaScript", "Astro"];
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
const finished = true; // jajajajaj que duro
---
<style define:vars={{ skillColor, fontWeight, textCase }}>
	h1 {
		color: purple;
		font-size: 4rem;
	}
	.skill {
		color: var(--skillColor);
		font-weight: var(--fontWeight);
		text-transform: var(--textCase);
	}
</style>

<BaseLayout pageTitle={pageTitle}>
	<p>Cosas interesantes:</p>
	<ul>
		<li>Me llamo {identity.firstName}.</li>
		<li>Vivo en {identity.city}, {identity.country}.</li>
		<li>Ahorita soy {identity.occupation}.</li>
		{identity.hobbies.length >= 1 &&
			<li>Mi hobby es el: {identity.hobbies[0]}</li>
		}
	</ul>
	<p>Mis disque habilidades:</p>
	<ul>
		{skills.map((skill) => <li class="skill">{skill}</li>)}
	</ul>
</BaseLayout>