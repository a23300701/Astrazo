---
import Hamburger from './Hamburger.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
---
<header>
	<nav>
		<Hamburger />
		<ThemeIcon/>
		<Navigation />
	</nav>
</header>
<style>
	header {
		background: rgba(255, 255, 255, 0.2);
		border-radius: 16px;
		backdrop-filter: blur(15px);
		padding: 1.5rem;
	}
</style>